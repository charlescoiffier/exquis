{
  "name": "exquis",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local src/lib/db/migrate.ts",
    "dev:web": "tsx scripts/dev.ts web",
    "dev:phone": "tsx scripts/dev.ts phone",
    "worker": "tsx --env-file-if-exists=.env.local src/worker.ts",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:dev": "tsx scripts/dev-db.ts",
    "capture:readme": "tsx scripts/capture-readme.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "next": "15.5.27",
    "pg-boss": "^10.4.2",
    "postgres": "^3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
